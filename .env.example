# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Required
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
MCP_API_KEY=your-mcp-api-key-here
FHIR_BASE_URL=https://your-fhir-server.example.com/fhir

# Optional
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=300

# Voice (TTS): primary backend uses OPENAI_API_KEY above. Set GOOGLE_TTS_API_KEY
# only if you want Google as a secondary fallback.
GOOGLE_TTS_API_KEY=
